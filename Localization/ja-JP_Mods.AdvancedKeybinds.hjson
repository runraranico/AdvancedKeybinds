	AdvancedKeybindsConfig: {
		DisplayName: 設定

		HoldTierHudCustomPositionX: {
			Label: Holdゲージ カスタム位置 X
			Tooltip: ""
		}

		HoldTierHudCustomPositionY: {
			Label: Holdゲージ カスタム位置 Y
			Tooltip: ""
		}
	}

	GamePadInputMode: {
		Tooltip: ""

		Auto: {
			Label: 自動
			Tooltip: ""
		}

		Enabled: {
			Label: 有効
			Tooltip: キーの登録ができない場合はこちらをお試しください
		}

		Disabled: {
			Label: 無効
			Tooltip: コントローラーを利用しない場合はこちらがオススメ
		}
	}

	HoldTierHudAnchor: {
		Tooltip: ""

		Feet: {
			Label: 足元
			Tooltip: ""
		}
		Mouse: {
			Label: マウス
			Tooltip: ""
		}
		Custom: {
			Label: カスタム
			Tooltip: 「ドラッグ許可」をオンにして、ゲージをミドルクリック（マウスホイール押し込み）で移動
		}
	}
}

Config: {
	WindowsKey: {
		Header: UI制御 / 特殊キー
		Suppress: {
			Label: Windowsキーを抑制する
			Tooltip: Winキーをバインドに使う場合はオン推奨
		}
		SuppressDebugUi: {
			Label: TerrariaのデバッグUIキーを抑制する
			Tooltip: F7・F8・F10・F11で開くTerrariaの特殊UIを抑制します。キー登録やMODアクションには引き続き使用できます
		}
		SuppressImeDuringKeyCapture: {
			Label: キー登録中はIMEを一時停止
			Tooltip: Input Method Fixer導入時かつIMEオンのとき、コンボパネルでキー登録している間だけIMEをオフにし、終了後に戻します
		}
	}
	Guide: {
		NotesHeader: ウィンドウへのカーソル固定
		CursorConfineToggle: {
			Label: ウィンドウ内に固定
			Tooltip: ゲームウィンドウ画面から外にマウスカーソルが移動できなくなります。隠しショートカット [c/FF9B00:Ctrl+Shift+Alt+M] でも切り替えできます
		}
		CursorConfineOnLoad: {
			Label: 次回MODロード時に自動で開始
			Tooltip: オンなら次回MODロード時にウィンドウ内固定をオンで開始し、オフならオフで開始します
		}
	}

	GamePad: {
		Header: コントローラー

		Mode: {
			Label: コントローラー入力
			Tooltip: Advanced Keybinds がコントローラーを読み取る方法。詳細は下の各選択肢の説明を参照
		}
	}

	HoldTierHud: {
		Header: 離した時Holdゲージ

		Enabled: {
			Label: Holdゲージを表示
			Tooltip: 同じキーに「離した時」Holdが2つ以上あるとき、押し続け中にチャージゲージを出します
		}

		AllowDrag: {
			Label: ドラッグ許可
			Tooltip: ゲージ位置がカスタムの場合はミドルクリックでバーを掴んで移動できます。
		}

		CustomGaugeHoverTip: 「ドラッグ許可」をオンにして、ゲージをミドルクリック（マウスホイール押し込み）で移動

		Anchor: {
			Label: ゲージ位置
			Tooltip: 足元 / マウス追従 / カスタム（ドラッグ許可をオンにして設定）。切替キーは足元→マウス→カスタム→足元…と循環します
		}

		BarWidth: {
			Label: ゲージの長さ
			Tooltip: 横バーの幅（150〜500ピクセル）。既定200。
		}

		Color: {
			Label: ゲージの色
			Tooltip: 赤・緑・青のスライダーで色を決めます
		}

		CustomPositionX: {
			Label: カスタム位置 X
			Tooltip: カスタムアンカーの横座標。ゲージをドラッグすると自動で更新されます。-1 は未設定。
		}

		CustomPositionY: {
			Label: カスタム位置 Y
			Tooltip: カスタムアンカーの縦座標。ゲージをドラッグすると自動で更新されます。-1 は未設定。
		}
	}









































































































































































































	ColorChannel: {
		Red.Label: 赤
		Green.Label: 緑
		Blue.Label: 青
		Alpha.Label: 透明度
	}
}

