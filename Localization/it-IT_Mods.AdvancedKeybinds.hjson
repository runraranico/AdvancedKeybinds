}

Configs: {
	AdvancedKeybindsConfig: {
		DisplayName: Impostazioni

		HoldTierHudCustomPositionX: {
			Label: Posizione personalizzata X barra Hold
			Tooltip: ""
		}

		HoldTierHudCustomPositionY: {
			Label: Posizione personalizzata Y barra Hold
			Tooltip: ""
		}
	}

	GamePadInputMode: {
		Tooltip: ""

		Auto: {
			Label: Automatico
			Tooltip: ""
		}

		Enabled: {
			Label: Attivo
			Tooltip: Se i tasti non si registrano, prova questa opzione
		}

		Disabled: {
			Label: Disattivato
			Tooltip: Consigliato se non usi un controller
		}
	}

	HoldTierHudAnchor: {
		Tooltip: ""

		Feet: {
			Label: Piedi
			Tooltip: ""
		}

		Mouse: {
			Label: Mouse
			Tooltip: ""
		}

		Custom: {
			Label: Personalizzato
			Tooltip: Attiva « Consenti trascinamento » e clic centrale (premendo la rotella) sulla barra per spostare
		}
	}
}

Config: {
	WindowsKey: {
		Header: Controllo UI / Tasti speciali

		Suppress: {
			Label: Sopprimi tasto Windows
			Tooltip: Lascia attivo se associ il tasto Windows
		}

		SuppressDebugUi: {
			Label: Sopprimi hotkey UI di debug di Terraria
			Tooltip: Impedisce l'apertura dell'UI speciale di Terraria con F7, F8, F10 e F11. I tasti restano utilizzabili per binding e azioni del mod.
		}
	}

	Guide: {
		NotesHeader: Blocca cursore nella finestra

		CursorConfineToggle: {
			Label: Confina il cursore nella finestra
			Tooltip: Il cursore del mouse non può uscire dalla finestra di gioco. Puoi anche cambiare con la scorciatoia nascosta [c/FF9B00:Ctrl+Shift+Alt+M]
		}

		CursorConfineOnLoad: {
			Label: Attiva automaticamente al prossimo caricamento del mod
			Tooltip: Attivo: avvia con blocco al prossimo caricamento. Disattivo: avvia senza blocco al prossimo caricamento
		}
	}

	GamePad: {
		Header: Controller

		Mode: {
			Label: Input controller
			Tooltip: Come Advanced Keybinds legge il controller. Vedi ogni opzione sotto per i dettagli
		}
	}

	HoldTierHud: {
		Header: Barra Hold al rilascio

		Enabled: {
			Label: Mostra barra Hold
			Tooltip: Tenendo premuto un tasto con 2+ Hold al rilascio, mostra una barra di carica
		}

		AllowDrag: {
			Label: Consenti trascinamento
			Tooltip: Quando la posizione della barra è Personalizzato, puoi trascinarla con il clic centrale.
		}

		CustomGaugeHoverTip: Attiva « Consenti trascinamento » e clic centrale (premendo la rotella) sulla barra per spostare

		Anchor: {
			Label: Posizione della barra
			Tooltip: Piedi, mouse o personalizzato (attiva Consenti trascinamento per impostare). Il tasto cicla Piedi → Mouse → Personalizzato → Piedi
		}

		BarWidth: {
			Label: Lunghezza della barra
			Tooltip: Larghezza orizzontale della barra in pixel (150–500). Predefinito 200.
		}

		Color: {
			Label: Colore della barra
			Tooltip: Cursori Rosso / Verde / Blu
		}

		CustomPositionX: {
			Label: Posizione personalizzata X
			Tooltip: Coordinata orizzontale sullo schermo per l'ancora personalizzata. Impostata automaticamente trascinando la barra. -1 = non ancora impostata.
		}

		CustomPositionY: {
			Label: Posizione personalizzata Y
			Tooltip: Coordinata verticale sullo schermo per l'ancora personalizzata. Impostata automaticamente trascinando la barra. -1 = non ancora impostata.
		}
	}

	ColorChannel: {
		Red.Label: Rosso
		Green.Label: Verde
		Blue.Label: Blu
		Alpha.Label: Alfa
	}
}

Hints.WinKeySuppress: Apri le impostazioni di Advanced Keybinds e controlla la soppressione del tasto Windows

CursorConfine: {
	Enabled: Blocco cursore ON
	Disabled: Blocco cursore OFF
	WindowsOnly: Blocca il cursore nella finestra e disponibile solo su Windows
}

