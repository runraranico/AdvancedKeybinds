	AdditionalOr: {
		TabAnd: Kombo (AND)
		TabOr: Zusatztaste (OR)
		TabAndTooltipTitle: Kombo (AND)
		TabAndTooltipBody: Wird ausgelöst, wenn alle registrierten Tasten gleichzeitig gedrückt werden
		TabOrTooltipTitle: Zusatztaste (OR)
		TabOrTooltipBody: Erweitert die nutzbaren Tasten
		CenterLabel: Zusatztasten-Einrichtung
		SlotEmpty: Zusatztaste
		HintLine1: Linksklick auf das rechte Feld, um eine Zusatztaste zu registrieren
