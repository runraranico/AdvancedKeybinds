Keybinds: {
	OpenSettingsMenu.DisplayName: Einstellungen öffnen
	OpenKeybindMenu.DisplayName: Steuerung öffnen
	OpenModConfigMenu.DisplayName: Mod-Konfiguration öffnen
	CycleHoldTierHudAnchor.DisplayName: Hold-HUD umschalten
	OpenBindingList.DisplayName: Tasteneinstellungsliste
}

Configs: {
	AdvancedKeybindsConfig: {
		DisplayName: Einstellungen

		HoldTierHudCustomPositionX: {
			Label: Hold-Leiste benutzerdefinierte Position X
			Tooltip: ""
		}

		HoldTierHudCustomPositionY: {
			Label: Hold-Leiste benutzerdefinierte Position Y
			Tooltip: ""
		}
	}

	GamePadInputMode: {
		Tooltip: ""

		Auto: {
			Label: Automatisch
			Tooltip: ""
		}

		Enabled: {
			Label: Aktiviert
			Tooltip: Falls sich keine Tasten zuweisen lassen, dies testen
		}

		Disabled: {
			Label: Deaktiviert
			Tooltip: Empfohlen, wenn du keinen Controller nutzt
		}
	}

	HoldTierHudAnchor: {
		Tooltip: ""

		Feet: {
			Label: Füße
			Tooltip: ""
		}

		Mouse: {
			Label: Maus
			Tooltip: ""
		}

		Custom: {
			Label: Benutzerdefiniert
			Tooltip: Aktiviere „Ziehen erlauben“ und die Leiste mit Mittelklick (Mausrad drücken) verschieben
		}
	}
}

Config: {
	WindowsKey: {
		Header: UI-Steuerung / Spezielle Tasten

		Suppress: {
			Label: Windows-Taste unterdrücken
			Tooltip: Eingeschaltet lassen, wenn du die Windows-Taste belegst
		}

		SuppressDebugUi: {
			Label: Terraria-Debug-UI-Hotkeys unterdrücken
			Tooltip: Verhindert, dass Terrarias spezielle UI mit F7, F8, F10 und F11 geöffnet wird. Die Tasten können weiterhin für Tastenbelegungen und Mod-Aktionen verwendet werden.
		}

		SuppressImeDuringKeyCapture: {
			Label: IME während der Tastenbelegung pausieren
			Tooltip: Wenn Input Method Fixer installiert ist und die IME aktiv ist, wird die IME nur während der Tastenregistrierung im Kombofeld vorübergehend ausgeschaltet und danach wiederhergestellt.
		}
	}

	Guide: {
		NotesHeader: Mauszeiger im Fenster sperren

		CursorConfineToggle: {
			Label: Mauszeiger im Fenster halten
			Tooltip: Der Mauszeiger kann das Spielfenster nicht verlassen. Du kannst das auch über das versteckte Kürzel [c/FF9B00:Ctrl+Shift+Alt+M] umschalten
		}

		CursorConfineOnLoad: {
			Label: Beim nächsten Mod-Laden automatisch aktivieren
			Tooltip: An: beim nächsten Mod-Laden mit Sperre starten. Aus: beim nächsten Laden ohne Sperre starten
		}
	}

	GamePad: {
		Header: Controller

		Mode: {
			Label: Controller-Eingabe
			Tooltip: Wie Advanced Keybinds deinen Controller ausliest. Details siehe die Optionen unten
		}
	}

	HoldTierHud: {
		Header: Hold beim Loslassen

		Enabled: {
			Label: Hold-Leiste anzeigen
			Tooltip: Zeigt beim Halten einer Taste mit 2+ Holds beim Loslassen eine Ladeleiste
		}

		AllowDrag: {
			Label: Ziehen erlauben
			Tooltip: Wenn die Leistenposition auf Benutzerdefiniert steht, kannst du die Leiste per Mittelklick greifen und verschieben.
		}

		CustomGaugeHoverTip: Aktiviere „Ziehen erlauben“ und die Leiste mit Mittelklick (Mausrad drücken) verschieben

		Anchor: {
			Label: Leistenposition
			Tooltip: Füße, Maus oder benutzerdefiniert (Ziehen erlauben aktivieren). Die Umschalttaste wechselt Füße → Maus → Benutzerdefiniert → Füße
		}

		BarWidth: {
			Label: Leistenlänge
			Tooltip: Breite der horizontalen Leiste in Pixeln (150–500). Standard 200.
		}

		Color: {
			Label: Leistenfarbe
			Tooltip: Farbe mit Rot-/Grün-/Blau-Schiebereglern
		}

		CustomPositionX: {
			Label: Benutzerdefinierte Position X
			Tooltip: Horizontale Bildschirmkoordinate für den benutzerdefinierten Anker. Wird beim Ziehen der Leiste automatisch gesetzt. -1 = noch nicht gesetzt.
		}

		CustomPositionY: {
			Label: Benutzerdefinierte Position Y
			Tooltip: Vertikale Bildschirmkoordinate für den benutzerdefinierten Anker. Wird beim Ziehen der Leiste automatisch gesetzt. -1 = noch nicht gesetzt.
		}
	}

	ColorChannel: {
		Red.Label: Rot
		Green.Label: Grün
		Blue.Label: Blau
		Alpha.Label: Alpha
	}
}

Hints.WinKeySuppress: Öffne die Advanced Keybinds-Einstellungen und prüfe die Windows-Taste-Unterdrückung

CursorConfine: {
	Enabled: Mauszeiger-Sperre AN
	Disabled: Mauszeiger-Sperre AUS
	WindowsOnly: Mauszeiger im Fenster sperren ist nur unter Windows verfügbar
}

