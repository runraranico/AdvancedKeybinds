	AdvancedKeybindsConfig: {
		DisplayName: Настройки

		HoldTierHudCustomPositionX: {
			Label: Своя позиция X индикатора Hold
			Tooltip: ""
		}

		HoldTierHudCustomPositionY: {
			Label: Своя позиция Y индикатора Hold
			Tooltip: ""
		}
	}

	GamePadInputMode: {
		Tooltip: ""

		Auto: {
			Label: Автоматически
			Tooltip: ""
		}

		Enabled: {
			Label: Включено
			Tooltip: Если клавиши не назначаются, попробуйте этот режим
		}

		Disabled: {
			Label: Отключено
			Tooltip: Рекомендуется, если вы не используете контроллер
		}
	}

	HoldTierHudAnchor: {
		Tooltip: ""

		Feet: {
			Label: Ноги
			Tooltip: ""
		}

		Mouse: {
			Label: Мышь
			Tooltip: ""
		}

		Custom: {
			Label: Своя
			Tooltip: Включите « Разрешить перетаскивание » и нажмите средней кнопкой мыши (нажатие колёсика) на полосу, чтобы переместить
		}
	}
}

Config: {
	WindowsKey: {
		Header: Управление UI / Особые клавиши

		Suppress: {
			Label: Блокировать клавишу Windows
			Tooltip: Оставляйте включённым, если привязываете клавишу Windows
		}

		SuppressDebugUi: {
			Label: Блокировать горячие клавиши отладочного UI Terraria
			Tooltip: Не даёт открываться специальному UI Terraria по F7, F8, F10 и F11. Клавиши по-прежнему можно использовать для привязок и действий мода.
		}

		SuppressImeDuringKeyCapture: {
			Label: Приостановить IME при назначении клавиш
			Tooltip: Если установлен Input Method Fixer и IME включён, временно отключает IME только во время регистрации клавиши на панели комбо, затем восстанавливает.
		}
	}

	Guide: {
		NotesHeader: Блокировка курсора в окне

		CursorConfineToggle: {
			Label: Удерживать курсор в окне
			Tooltip: Курсор мыши не может выйти за пределы окна игры. Также можно переключать скрытым сочетанием [c/FF9B00:Ctrl+Shift+Alt+M]
		}

		CursorConfineOnLoad: {
			Label: Автоматически включать при следующей загрузке мода
			Tooltip: Вкл.: старт с блокировкой при следующей загрузке. Выкл.: старт без блокировки при следующей загрузке
		}
	}

	GamePad: {
		Header: Контроллер

		Mode: {
			Label: Ввод с контроллера
			Tooltip: Как Advanced Keybinds считывает контроллер. Подробности в описании каждого варианта ниже
		}
	}

	HoldTierHud: {
		Header: Индикатор Hold при отпускании

		Enabled: {
			Label: Показывать индикатор Hold
			Tooltip: При удержании клавиши с 2+ Hold при отпускании показывает полосу зарядки
		}

		AllowDrag: {
			Label: Разрешить перетаскивание
			Tooltip: Если позиция индикатора — «Своя», средней кнопкой мыши можно схватить и переместить полосу.
		}

		CustomGaugeHoverTip: Включите « Разрешить перетаскивание » и нажмите средней кнопкой мыши (нажатие колёсика) на полосу, чтобы переместить

		Anchor: {
			Label: Позиция индикатора
			Tooltip: Ноги, мышь или своя (включите Разрешить перетаскивание). Горячая клавиша циклирует Ноги → Мышь → Своя → Ноги
		}

		BarWidth: {
			Label: Длина индикатора
			Tooltip: Ширина горизонтальной полосы в пикселях (150–500). По умолчанию 200.
		}

		Color: {
			Label: Цвет индикатора
			Tooltip: Ползунки Красный / Зелёный / Синий
		}

		CustomPositionX: {
			Label: Своя позиция X
			Tooltip: Горизонтальная экранная координата своей привязки. Задаётся автоматически при перетаскивании. -1 = ещё не задана.
		}

		CustomPositionY: {
			Label: Своя позиция Y
			Tooltip: Вертикальная экранная координата своей привязки. Задаётся автоматически при перетаскивании. -1 = ещё не задана.
		}
	}

	ColorChannel: {
		Red.Label: Красный
		Green.Label: Зелёный
		Blue.Label: Синий
		Alpha.Label: Альфа
	}
}

Hints.WinKeySuppress: Откройте настройки Advanced Keybinds и проверьте подавление клавиши Windows

