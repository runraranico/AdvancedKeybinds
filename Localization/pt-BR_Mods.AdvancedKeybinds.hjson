Configs: {
	AdvancedKeybindsConfig: {
		DisplayName: Configuracoes

		HoldTierHudCustomPositionX: {
			Label: Posição personalizada X da barra Hold
			Tooltip: ""
		}

		HoldTierHudCustomPositionY: {
			Label: Posição personalizada Y da barra Hold
			Tooltip: ""
		}
	}

	GamePadInputMode: {
		Tooltip: ""

		Auto: {
			Label: Automático
			Tooltip: ""
		}

		Enabled: {
			Label: Ativado
			Tooltip: Se não conseguir registrar teclas, tente esta opção
		}

		Disabled: {
			Label: Desativado
			Tooltip: Recomendado se você não usa controle
		}
	}

	HoldTierHudAnchor: {
		Tooltip: ""

		Feet: {
			Label: Pés
			Tooltip: ""
		}

		Mouse: {
			Label: Mouse
			Tooltip: ""
		}

		Custom: {
			Label: Personalizado
			Tooltip: Ative « Permitir arrastar » e clique do meio (pressionar a roda) na barra para mover
		}
	}
}

Config: {
	WindowsKey: {
		Header: Controle de UI / Teclas especiais

		Suppress: {
			Label: Suprimir tecla Windows
			Tooltip: Mantenha ligado se você vincular a tecla Windows
		}

		SuppressDebugUi: {
			Label: Suprimir atalhos de UI de depuração do Terraria
			Tooltip: Impede que a UI especial do Terraria abra com F7, F8, F10 e F11. As teclas ainda podem ser usadas para binds e ações do mod.
		}

		SuppressImeDuringKeyCapture: {
			Label: Pausar IME ao vincular teclas
			Tooltip: Quando o Input Method Fixer está instalado e o IME está ligado, desativa temporariamente o IME apenas enquanto você vincula uma tecla no painel de combo e depois restaura.
		}
	}

	Guide: {
		NotesHeader: Travar cursor na janela

		CursorConfineToggle: {
			Label: Confinar cursor à janela
			Tooltip: O cursor do mouse não pode sair da janela do jogo. Você também pode alternar com o atalho oculto [c/FF9B00:Ctrl+Shift+Alt+M]
		}

		CursorConfineOnLoad: {
			Label: Ativar automaticamente no próximo carregamento do mod
			Tooltip: Ligado: iniciar com travamento no próximo carregamento. Desligado: iniciar sem travamento no próximo carregamento
		}
	}

	GamePad: {
		Header: Controle

		Mode: {
			Label: Entrada do controle
			Tooltip: Como o Advanced Keybinds lê o seu controle. Veja cada opção abaixo para detalhes
		}
	}

	HoldTierHud: {
		Header: Barra de Hold ao soltar

		Enabled: {
			Label: Mostrar barra de Hold
			Tooltip: Ao segurar uma tecla com 2+ Holds ao soltar, mostra uma barra de carga
		}

		AllowDrag: {
			Label: Permitir arrastar
			Tooltip: Quando a posição da barra for Personalizado, você pode clicar com o botão do meio para agarrá-la e movê-la.
		}

		CustomGaugeHoverTip: Ative « Permitir arrastar » e clique do meio (pressionar a roda) na barra para mover

		Anchor: {
			Label: Posição da barra
			Tooltip: Pés, mouse ou personalizado (ative Permitir arrastar para definir). O atalho cicla Pés → Mouse → Personalizado → Pés
		}

		BarWidth: {
			Label: Comprimento da barra
			Tooltip: Largura horizontal da barra em pixels (150–500). Padrão 200.
		}

		Color: {
			Label: Cor da barra
			Tooltip: Controles Vermelho / Verde / Azul
		}

		CustomPositionX: {
			Label: Posição personalizada X
			Tooltip: Coordenada horizontal na tela da âncora personalizada. Definida automaticamente ao arrastar a barra. -1 = ainda não definida.
		}

		CustomPositionY: {
			Label: Posição personalizada Y
			Tooltip: Coordenada vertical na tela da âncora personalizada. Definida automaticamente ao arrastar a barra. -1 = ainda não definida.
		}
	}

	ColorChannel: {
		Red.Label: Vermelho
		Green.Label: Verde
		Blue.Label: Azul
		Alpha.Label: Alfa
	}
}

Hints.WinKeySuppress: Abra as configurações do Advanced Keybinds e verifique a supressão da tecla Windows

CursorConfine: {
	Enabled: Travamento do cursor LIGADO
	Disabled: Travamento do cursor DESLIGADO
	WindowsOnly: Travar o cursor na janela esta disponivel apenas no Windows
}

