Keybinds: {
	OpenSettingsMenu.DisplayName: 打开设置
	OpenKeybindMenu.DisplayName: 打开控制
	OpenModConfigMenu.DisplayName: 打开模组配置
	CycleHoldTierHudAnchor.DisplayName: 切换 Hold HUD
}

Configs: {
	AdvancedKeybindsConfig: {
		DisplayName: 设置

		HoldTierHudCustomPositionX: {
			Label: Hold 量条自定义位置 X
			Tooltip: ""
		}

		HoldTierHudCustomPositionY: {
			Label: Hold 量条自定义位置 Y
			Tooltip: ""
		}
	}

	GamePadInputMode: {
		Tooltip: ""

		Auto: {
			Label: 自动
			Tooltip: ""
		}

		Enabled: {
			Label: 启用
			Tooltip: 无法注册按键时可以试试此项
		}

		Disabled: {
			Label: 禁用
			Tooltip: 不使用手柄时推荐选择此项
		}
	}

	HoldTierHudAnchor: {
		Tooltip: ""

		Feet: {
			Label: 脚下
			Tooltip: ""
		}

		Mouse: {
			Label: 鼠标
			Tooltip: ""
		}

		Custom: {
			Label: 自定义
			Tooltip: 启用“允许拖动”后，用中键（按下滚轮）点击量条即可移动
		}
	}
}

Config: {
	WindowsKey: {
		Header: UI 控制 / 特殊按键

		Suppress: {
			Label: 抑制 Windows 键
			Tooltip: 若绑定 Windows 键，请保持开启
		}

		SuppressDebugUi: {
			Label: 屏蔽 Terraria 调试 UI 快捷键
			Tooltip: 防止用 F7、F8、F10、F11 打开 Terraria 的特殊 UI。这些键仍可用于键位绑定和模组操作。
		}
	}

	Guide: {
		NotesHeader: 将光标锁定到窗口

		CursorConfineToggle: {
			Label: 将光标限制在窗口内
			Tooltip: 鼠标光标将无法移出游戏窗口画面。也可以通过隐藏快捷键 [c/FF9B00:Ctrl+Shift+Alt+M] 切换
		}

		CursorConfineOnLoad: {
			Label: 下次加载模组时自动启用
			Tooltip: 开启：下次加载模组时以光标锁定开启状态开始。关闭：下次加载时以关闭状态开始
		}
	}

	GamePad: {
		Header: 手柄

		Mode: {
			Label: 手柄输入
			Tooltip: Advanced Keybinds 读取手柄的方式。详情见下方各选项说明
		}
	}

	HoldTierHud: {
		Header: 松开时 Hold 量条

		Enabled: {
			Label: 显示 Hold 量条
			Tooltip: 按住带有 2 个及以上“松开时”Hold 的键时，显示充能量条
		}

		AllowDrag: {
			Label: 允许拖动
			Tooltip: 当量条位置为自定义时，可用中键抓住并移动量条。
		}

		CustomGaugeHoverTip: 启用“允许拖动”后，用中键（按下滚轮）点击量条即可移动

		Anchor: {
			Label: 量条位置
			Tooltip: 脚下、鼠标或自定义（需启用允许拖动）。快捷键循环：脚下 → 鼠标 → 自定义 → 脚下
		}

		BarWidth: {
			Label: 量条长度
			Tooltip: 水平条宽度（像素，150–500）。默认 200。
		}

		Color: {
			Label: 量条颜色
			Tooltip: 红 / 绿 / 蓝 滑块
		}

		CustomPositionX: {
			Label: 自定义位置 X
			Tooltip: 自定义锚点的屏幕横坐标。拖动量条时自动设定。-1 = 尚未设定。
		}

		CustomPositionY: {
			Label: 自定义位置 Y
			Tooltip: 自定义锚点的屏幕纵坐标。拖动量条时自动设定。-1 = 尚未设定。
		}
	}

	ColorChannel: {
		Red.Label: 红
		Green.Label: 绿
		Blue.Label: 蓝
		Alpha.Label: 透明度
	}
}

Hints.WinKeySuppress: 打开 Advanced Keybinds 设置并检查 Windows 键抑制

CursorConfine: {
	Enabled: 光标锁定 开
	Disabled: 光标锁定 关
	WindowsOnly: 将光标锁定到窗口仅支持 Windows
}

UI: {
	KeybindRow: {
		OutsideSlotTip: 光标选中操作名时，右键设为未设置（需确认），中键恢复默认
		ConfirmUnsetHover: 再右键一次设为未设置
	}

	Combo: {
		Press: 按下按键...
		Empty: (空)
		Unset: (未设置)
		Clear: 清除
		Undo: 撤销
		Save: 保存
		HintLine1: 左键点击槽位，然后按下按键或鼠标按钮。
		HintLine2: Hold 仅限 1 键时可用。
		HintLine3: 将光标移到槽位上并右键点击以清除设置。
		HoldDefaultLabel: 默认
		HoldWhileHeldTitle: Hold
		HoldWhileHeldHint: 按住时
		HoldOnReleaseTitle: Hold
		HoldOnReleaseHint: 松开时
		HoldPreviewWhileHeld: Hold
		HoldPreviewOnRelease: Hold↑
		HoldMsInputTooltip: 可输入 10～10000
		ConfirmLeftClickOnly: 要单独绑定左键吗？再按一次保存以确认。
		ClearConfirmPad: 要清除吗？
		RejectOppositeStickDirection: 同一摇杆的相反方向不能同时绑定（例如 上+下）
		KeyInfoSelectHint: 请选择按键
		KeyInfoSelectGuide: 选择按键
		KeyInfoCurrent: 原始按键
		KeyInfoDisplay: 显示名称
		KeyInfoDefault: 默认名称
		KeyInfoScan: ScanCode
		KeyInfoNone: 无
		KeyInfoPresent: 有
		KeyInfoNamePlaceholder: 更改按键显示名称
		KeyInfoPressHint: 请按下按键
		KeyInfoAwaitHeader: 要更改的按键
		KeyInfoNameGuideLine1: 新的显示名称
		KeyInfoNameGuideLine2: 在此输入文字
		KeyInfoNameGuideLine3: 按 Enter 确认
		KeyInfoResetDisplays: 重置显示名称
		KeyInfoResetDisplaysLine1: 将所有登记显示
		KeyInfoResetDisplaysLine2: 还原为默认
		KeyInfoResetDisplaysConfirm: 要将所有自定义按键显示名称还原为默认吗？
		KeyInfoDisplayRestored: 已将显示名称 {0} 还原为 {1}
		SlotOriginalKey: 原始：{0}
		SlotDisplayNameHover: "{0}: {1}"

		DisplayNameUnavailable: {
			Line1: 显示名更改功能
			Line2: 在使用控制器时
			Line3: 将停用
		}

		MouseWheelUp: Wheel Up
		MouseWheelDown: Wheel Down
		MouseWheelLeft: Wheel Left
		MouseWheelRight: Wheel Right
	}

	TwoKeySetup: {
		Line1: 双键设置
		Line2: ""
		Line3: ""
		Line4: ""
		HintLine1: 仅限手柄
		HintLine2: 任一键可触发
		HintLine3: ""
		HoldUnavailableHint: 不可用
	}
}
