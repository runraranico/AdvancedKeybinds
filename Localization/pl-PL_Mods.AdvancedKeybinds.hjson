		Custom: {
			Label: Własna
			Tooltip: Włącz « Zezwól na przeciąganie » i kliknij pasek środkowym przyciskiem (naciśnięcie kółka), aby przesunąć
		}
	}
}

Config: {
	WindowsKey: {
		Header: Sterowanie UI / Specjalne klawisze

		Suppress: {
			Label: Blokuj klawisz Windows
			Tooltip: Pozostaw włączone, jeśli przypisujesz klawisz Windows
		}

		SuppressDebugUi: {
			Label: Blokuj skróty UI debugowania Terrarii
			Tooltip: Zapobiega otwieraniu specjalnego UI Terrarii klawiszami F7, F8, F10 i F11. Klawisze nadal można używać do przypisań i akcji moda.
		}

		SuppressImeDuringKeyCapture: {
			Label: Wstrzymaj IME podczas przypisywania klawiszy
			Tooltip: Gdy Input Method Fixer jest zainstalowany i IME jest włączone, tymczasowo wyłącza IME tylko podczas rejestracji klawisza w panelu combo, a potem je przywraca.
		}
	}

	Guide: {
		NotesHeader: Blokada kursora w oknie

		CursorConfineToggle: {
			Label: Ogranicz kursor do okna
			Tooltip: Kursor myszy nie może wyjść poza okno gry. Możesz też przełączyć ukrytym skrótem [c/FF9B00:Ctrl+Shift+Alt+M]
		}

		CursorConfineOnLoad: {
			Label: Automatycznie wlacz przy nastepnym ladowaniu moda
			Tooltip: Włączone: start z blokadą przy następnym ładowaniu. Wyłączone: start bez blokady przy następnym ładowaniu
		}
	}

	GamePad: {
		Header: Kontroler

		Mode: {
			Label: Wejście kontrolera
			Tooltip: Sposób, w jaki Advanced Keybinds odczytuje kontroler. Szczegóły w opisach poszczególnych opcji poniżej
		}
	}

	HoldTierHud: {
		Header: Pasek Hold po puszczeniu

		Enabled: {
			Label: Pokaż pasek Hold
			Tooltip: Przy trzymaniu klawisza z 2+ Holdami po puszczeniu pokazuje pasek ładowania
		}

		AllowDrag: {
			Label: Zezwól na przeciąganie
			Tooltip: Gdy pozycja paska to Własna, możesz chwycić i przesunąć pasek środkowym przyciskiem.
		}

		CustomGaugeHoverTip: Włącz « Zezwól na przeciąganie » i kliknij pasek środkowym przyciskiem (naciśnięcie kółka), aby przesunąć

		Anchor: {
			Label: Pozycja paska
			Tooltip: Stopy, mysz lub własna (włącz Zezwól na przeciąganie). Skrót cykluje Stopy → Mysz → Własna → Stopy
		}

		BarWidth: {
			Label: Długość paska
			Tooltip: Szerokość poziomego paska w pikselach (150–500). Domyślnie 200.
		}

		Color: {
			Label: Kolor paska
			Tooltip: Suwaki Czerwony / Zielony / Niebieski
		}

		CustomPositionX: {
			Label: Własna pozycja X
			Tooltip: Pozioma współrzędna ekranu własnej kotwicy. Ustawiana automatycznie przy przeciąganiu paska. -1 = jeszcze nie ustawiona.
		}

		CustomPositionY: {
			Label: Własna pozycja Y
			Tooltip: Pionowa współrzędna ekranu własnej kotwicy. Ustawiana automatycznie przy przeciąganiu paska. -1 = jeszcze nie ustawiona.
		}
	}

	ColorChannel: {
		Red.Label: Czerwony
		Green.Label: Zielony
		Blue.Label: Niebieski
		Alpha.Label: Alfa
	}
}

